{
  "expo": {
    "name": "Miss Migraine",
    "scheme": "missmigraine",
    "slug": "miss-migraine",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/icon.png",
        "backgroundColor": "#F0F6EF"
      },
      "package": "com.missmigraine.app"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.missmigraine.app"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F0F6EF"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "QuickLog",
              "label": "Log Migraine",
              "description": "Quickly log a severe migraine",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 1,
              "targetCellHeight": 1
            }
          ]
        }
      ],
      "expo-font",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-build-properties",
      "expo-android-keyboard-fix"
    ]
  }
}
